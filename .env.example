# Copy to .env and fill in. .env is git-ignored.
STORAGE_DIRECTORY=/mnt/storage
CONFIG_DIRECTORY=/mnt/flash/docker-everything-on-it/config
TZ=America/Chicago
PUID=1000
PGID=100

# Private Internet Access (vpn service). Named PIA_* because USER/PASS collide with the shell env.
PIA_USER=p0000000
PIA_PASS=change-me
# Port-forwarding exit. PIA offers no port forwarding in the US; Vancouver first: Toronto's PF API was refusing connections on 2026-10-18.
PIA_LOC=ca_vancouver,mexico,ca_ontario,ca_toronto
PIA_PORT_FORWARDING=1
# US exit without port forwarding (alternative):
#PIA_LOC=us_california,us_chicago
#PIA_PORT_FORWARDING=0

# Only needed if WebUI\LocalHostAuth is left enabled in qBittorrent.conf (see docs/vpn-qbittorrent.md)
QBT_USER=
QBT_PASS=
